library(scales)
fspec = function(x) ifelse(x<2000, x, 2000+(x-2000)/10)
fspec_1 = function(x) ifelse(x<2000, x, 2000+(x-2000)*10)
specTrans = trans_new(name = "specialTras",
transform = fspec,
inverse = fspec_1,
breaks = c(0, 1000, 2000, 3000, 4000, 5000, 6000))
gapminder%>% filter(year==c(year_min,year_max))%>%
ggplot(aes(continent,gdpPercap))+
geom_boxplot()+
facet_grid('year')+
coord_trans(y=specTrans)
## TASK: Create a visual of gdpPercap vs continent
library(scales)
fspec = function(x) ifelse(x<9000, x, 9000+(x-9000)/10)
fspec_1 = function(x) ifelse(x<9000, x, 9000+(x-9000)*10)
specTrans = trans_new(name = "specialTras",
transform = fspec,
inverse = fspec_1,
breaks = c(0, 1000, 2000, 3000, 4000, 5000, 6000))
gapminder%>% filter(year==c(year_min,year_max))%>%
ggplot(aes(continent,gdpPercap))+
geom_boxplot()+
facet_grid('year')+
coord_trans(y=specTrans)
