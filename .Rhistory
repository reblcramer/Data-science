library(scales)
fspec = function(x) ifelse(x<2000, x, 2000+(x-2000)/10)
fspec_1 = function(x) ifelse(x<2000, x, 2000+(x-2000)*10)
specTrans = trans_new(name = "specialTras",
transform = fspec,
inverse = fspec_1,
breaks = c(0, 1000, 2000, 3000, 4000, 5000, 6000))
gapminder%>% filter(year==c(year_min,year_max))%>%
ggplot(aes(continent,gdpPercap))+
geom_boxplot()+
facet_grid('year')+
coord_trans(y=specTrans)
## TASK: Create a visual of gdpPercap vs continent
library(scales)
fspec = function(x) ifelse(x<9000, x, 9000+(x-9000)/10)
fspec_1 = function(x) ifelse(x<9000, x, 9000+(x-9000)*10)
specTrans = trans_new(name = "specialTras",
transform = fspec,
inverse = fspec_1,
breaks = c(0, 1000, 2000, 3000, 4000, 5000, 6000))
gapminder%>% filter(year==c(year_min,year_max))%>%
ggplot(aes(continent,gdpPercap))+
geom_boxplot()+
facet_grid('year')+
coord_trans(y=specTrans)
library(tidyverse)
library(rsample)
## NOTE: No need to edit; this visual helps explain the pi estimation scheme
tibble(x = seq(0, 1, length.out = 100)) %>%
mutate(y = sqrt(1 - x^2)) %>%
ggplot(aes(x, y)) +
annotate(
"rect",
xmin = 0, ymin = 0, xmax = 1, ymax = 1,
fill = "grey40",
size = 1
) +
geom_ribbon(aes(ymin = 0, ymax = y), fill = "coral") +
geom_line() +
annotate(
"label",
x = 0.5, y = 0.5, label = "Sc",
size = 8
) +
annotate(
"label",
x = 0.8, y = 0.8, label = "St",
size = 8
) +
scale_x_continuous(breaks = c(0, 1/2, 1)) +
scale_y_continuous(breaks = c(0, 1/2, 1)) +
theme_minimal() +
coord_fixed()
